<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Maker</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f5f9;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .form {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .form input {
            flex: 1;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .add-btn {
            background: #007bff;
            color: white;
        }

        .present {
            background: #28a745;
            color: white;
        }

        .absent {
            background: #dc3545;
            color: white;
        }

        .delete {
            background: #6c757d;
            color: white;
        }

        .save {
            background: #673ab7;
            color: white;
            margin-top: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px;
            text-align: center;
            border: 1px solid #ddd;
        }

        th {
            background: #343a40;
            color: white;
        }

        .status {
            font-weight: bold;
        }

        .summary {
            margin-top: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        @media(max-width: 700px) {
            .form {
                flex-direction: column;
            }

            table {
                font-size: 12px;
            }

            button {
                padding: 7px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>📋 Attendance Maker</h1>

    <div class="form">
        <input type="text" id="studentName" placeholder="Enter student name">
        <input type="text" id="rollNo" placeholder="Enter roll number">

        <button class="add-btn" onclick="addStudent()">
            Add Student
        </button>
    </div>

    <table>
        <thead>
            <tr>
                <th>Roll No</th>
                <th>Student Name</th>
                <th>Present</th>
                <th>Absent</th>
                <th>Attendance %</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="studentTable">
        </tbody>
    </table>

    <div class="summary">
        <h3>Attendance Summary</h3>

        <p>Total Students:
            <strong id="totalStudents">0</strong>
        </p>

        <p>Total Present:
            <strong id="totalPresent">0</strong>
        </p>

        <p>Total Absent:
            <strong id="totalAbsent">0</strong>
        </p>
    </div>

    <button class="save" onclick="saveAttendance()">
        💾 Save Attendance
    </button>

    <button class="delete" onclick="clearAttendance()">
        🗑 Clear All
    </button>

</div>

<script>

    let students = JSON.parse(localStorage.getItem("students")) || [];

    function addStudent() {

        let name = document.getElementById("studentName").value.trim();
        let roll = document.getElementById("rollNo").value.trim();

        if (name === "" || roll === "") {
            alert("Please enter student name and roll number.");
            return;
        }

        let student = {
            roll: roll,
            name: name,
            present: 0,
            absent: 0
        };

        students.push(student);

        document.getElementById("studentName").value = "";
        document.getElementById("rollNo").value = "";

        displayStudents();
    }


    function markPresent(index) {

        students[index].present++;

        displayStudents();
    }


    function markAbsent(index) {

        students[index].absent++;

        displayStudents();
    }


    function deleteStudent(index) {

        if (confirm("Are you sure you want to delete this student?")) {

            students.splice(index, 1);

            displayStudents();
        }
    }


    function calculatePercentage(student) {

        let total = student.present + student.absent;

        if (total === 0) {
            return 0;
        }

        return ((student.present / total) * 100).toFixed(2);
    }


    function displayStudents() {

        let table = document.getElementById("studentTable");

        table.innerHTML = "";

        let totalPresent = 0;
        let totalAbsent = 0;

        students.forEach((student, index) => {

            totalPresent += student.present;
            totalAbsent += student.absent;

            let percentage = calculatePercentage(student);

            let status;

            if (percentage >= 75) {
                status = "Good";
            } else {
                status = "Low";
            }

            table.innerHTML += `

                <tr>

                    <td>${student.roll}</td>

                    <td>${student.name}</td>

                    <td>
                        <button
                            class="present"
                            onclick="markPresent(${index})">
                            + Present
                        </button>

                        <br>
                        ${student.present}
                    </td>

                    <td>
                        <button
                            class="absent"
                            onclick="markAbsent(${index})">
                            + Absent
                        </button>

                        <br>
                        ${student.absent}
                    </td>

                    <td>
                        ${percentage}%
                    </td>

                    <td class="status">
                        ${status}
                    </td>

                    <td>
                        <button
                            class="delete"
                            onclick="deleteStudent(${index})">
                            Delete
                        </button>
                    </td>

                </tr>

            `;
        });

        document.getElementById("totalStudents").innerText =
            students.length;

        document.getElementById("totalPresent").innerText =
            totalPresent;

        document.getElementById("totalAbsent").innerText =
            totalAbsent;

        localStorage.setItem("students", JSON.stringify(students));
    }


    function saveAttendance() {

        localStorage.setItem(
            "students",
            JSON.stringify(students)
        );

        alert("Attendance saved successfully!");
    }


    function clearAttendance() {

        if (confirm("Delete all attendance data?")) {

            students = [];

            localStorage.removeItem("students");

            displayStudents();
        }
    }


    displayStudents();

</script>

</body>
</html>
